{
  "swagger": "2.0",
  "info": {
    "title": "Job Aggregator Project API",
    "version": "1.0.0",
    "description": "Here you can find all the details about the routes that make up the API for our job aggregator project"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": ["http"],
  "tags": [
    {
      "name": "Auth",
      "description": "/api/auth"
    },
    {
      "name": "Offers",
      "description": "/api/offers"
    },
    {
      "name": "Users",
      "description": "/api/users"
    },{
      "name":"Recommendations",
      "description": "/api/recommendations"
    },
    {"name":"Companies",
    "description": "/api/companies"
  }
  ],
  "paths": {
    "/register": {
      "post": {
        "tags": ["Auth"],
        "description": "Register User and get a access token",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "example": "Martinjose@gmail.com"
                },
                "password": {
                  "type": "string",
                  "example": "Password123"
                },
                "last_name": {
                  "type": "string",
                  "example": "Martin"
                },
                "first_name": {
                  "type": "string",
                  "example": "Jose"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "You have successfully registered and received an access token",
            "schema": {
              "type": "object",
              "properties": {
                "token": {
                  "type": "string",
                  "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...."
                }
              }
            }
          },
          "400": {
            "description": "Value is missing or invalid"
          },
          "409": {
            "description": "User with this email already exists"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": ["Auth"],
        "description": "Login User and get a access token",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "example": "Martinjose@gmail.com"
                },
                "password": {
                  "type": "string",
                  "example": "Password123"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "You have successfully logged in and received an access token",
            "schema": {
              "type": "object",
              "properties": {
                "token": {
                  "type": "string",
                  "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...."
                }
              }
            }
          },
          "400": {
            "description": "Value is missing or invalid"
          },
          "401": {
            "description": "Unauthorized, incorrect email or password"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/allOffers": {
      "get": {
        "tags": ["Offers"],
        "description": "Get a list of all offers",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "int",
                    "example": 1
                  },
                  "title": {
                    "type": "string",
                    "example": "Software Engineer"
                  },
                  "company_id": {
                    "type": "int",
                    "example": 1
                    
                  },
                  "company_name": {
                    "type": "string",
                    "example": "Tech Company"
                  },
                  "location": {
                    "type": "string",
                    "example": "New York, NY"
                  },
                  "job_type": {
                    "type": "string",
                    "example": "CDI"
                  },
                  "work_type": {
                    "type": "string",
                    "example": "On-site"
                  },
                  "about": {
                    "type": "string",
                    "example": "We are looking for a skilled software engineer to join our team."
                  },
                  "salary": {
                    "type": "int",
                    "example": 120000
                  },
                  "skills": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": ["JavaScript", "Node.js", "React"]
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/offer/{offerId}": {
      "get": {
        "tags": ["Offers"],
        "description": "",
        "parameters": [
          {
            "name": "offerId",
            "in": "path",
            "required": true,
            "type": "int"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "int",
                  "example": 1
                },
                "title": {
                  "type": "string",
                  "example": "Software Engineer"
                },
                "company_id": {
                    "type": "int",
                    "example": 1
                },
                "company_name": {
                  "type": "string",
                  "example": "Tech Company"
                },
                "location": {
                  "type": "string",
                  "example": "New York, NY"
                },
                "job_type": {
                  "type": "string",
                  "example": "CDI"
                },
                "work_type": {
                  "type": "string",
                  "example": "On-site"
                },
                "about": {
                  "type": "string",
                  "example": "We are looking for a skilled software engineer to join our team."
                },
                "salary": {
                  "type": "int",
                  "example": 120000
                },
                "skills": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "example": ["JavaScript", "Node.js", "React"]
                }
              }
            }
          },
          "404": {
            "description": "offer with this id not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/offerLike/{offerId}": {
      "get": {
        "tags": ["Offers"],
        "description": "Get userId of users who liked the offer",
        "parameters": [
          {
            "name": "offerId",
            "in": "path",
            "required": true,
            "type": "int"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": {
                "type": "int",
                "example": 1
              }
            }
          },
          "404": {
            "description": "offer with this id not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/search/{searchText}": {
      "get": {
        "tags": ["Offers"],
        "description": "Return a list of 0 to 15 offers that match the search text in title, company, location, salary, job_type, work_type, about, requirements or skills,",
        "parameters": [
          {
            "name": "searchText",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "int",
                    "example": 1
                  },
                  "title": {
                    "type": "string",
                    "example": "Software Engineer"
                  },
                  "company_id": {
                    "type": "int",
                    "example": 1
                  },
                  "company_name": {
                    "type": "string",
                    "example": "Tech Company"
                  },
                  "location": {
                    "type": "string",
                    "example": "New York, NY"
                  },
                  "job_type": {
                    "type": "string",
                    "example": "CDI"
                  },
                  "work_type": {
                    "type": "string",
                    "example": "On-site"
                  },
                  "about": {
                    "type": "string",
                    "example": "We are looking for a skilled software engineer to join our team."
                  },
                  "salary": {
                    "type": "int",
                    "example": 120000
                  },
                  "skills": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": ["JavaScript", "Node.js", "React"]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Value is missing or invalid"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/newOfferView/{offerId}": {
      "post": {
        "description": "add userId to the list of users who viewed the offer",
        "tags": ["Offers"],
        "parameters": [
          {
            "name": "offerId",
            "in": "path",
            "required": true,
            "type": "int"
          }
        ],
        "responses": {
          "200": {
            "description": "view added to offer"
          },
          "400": {
            "description": "Value is missing or invalid"
          },
          "404": {
            "description": "offer with this id not found"
          },
          "409": {
            "description": "User has already viewed this offer"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/createOffer": {
      "post": {
        "description": "Create a new offer (admin only)",
        "tags": ["Offers"],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "example": "Developer"
                },
                "company_name": {
                  "type": "string",
                  "example": "Tech Company"
                },
                "location": {
                  "type": "string",
                  "example": "New York, NY"
                },
                "job_type": {
                  "type": "string",
                  "example": "CDI"
                },
                "work_type": {
                  "type": "string",
                  "example": "On-site"
                },
                "about": {
                  "type": "string",
                  "example": "We are looking for a skilled developer to join our team."
                },
                "salary": {
                  "type": "integer",
                  "example": 120000
                },
                "skills": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "example": ["JavaScript", "Node.js", "React"]
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "offer created successfully with id {offerId}"
          },
          "400": {
            "description": "Value is missing or invalid"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/handleOfferLike/{offerId}": {
      "put": {
        "description": "Like or unlike an offer (if the user has already liked the offer, it will be unliked, otherwise it will be liked)",
        "tags": ["Offers"],
        "parameters": [
          {
            "name": "offerId",
            "in": "path",
            "required": true,
            "type": "int"
          }
        ],
        "responses": {
          "200": {
            "description": "offer liked or unliked successfully"
          },
          "400": {
            "description": "Value is missing or invalid"
          },
          "404": {
            "description": "offer with this id not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/updateOffer/{offerId}": {
      "put": {
        "tags": ["Offers"],
        "description": "update an offer, all fields are required (admin only)",
        "parameters": [
          {
            "name": "offerId",
            "in": "path",
            "required": true,
            "type": "int"
          },
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "title": {
                  "example": "Developer"
                },
                "company_name": {
                  "example": "Tech Company"
                },
                "location": {
                  "example": "New York, NY"
                },
                "job_type": {
                  "example": "CDI"
                },
                "work_type": {
                  "example": "On-site"
                },
                "about": {
                  "example": "We are looking for a skilled developer to join our team."
                },
                "salary": {
                  "example": 120000
                },
                "skills": {
                  "example": ["JavaScript", "Node.js", "React"]
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "offer updated successfully"
          },
          "400": {
            "description": "Value is missing or invalid"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/deleteOffer/{offerId}": {
      "delete": {
        "tags": ["Offers"],
        "description": "delete offer (admin only)",
        "parameters": [
          {
            "name": "offerId",
            "in": "path",
            "required": true,
            "type": "int"
          }
        ],
        "responses": {
          "200": {
            "description": "offer deleted successfully"
          },
          "400": {
            "description": "Value is missing or invalid"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/similar/{offerId}": {
      "get": {
        "tags": ["Recommendations"],
        "description": "Get offers similar to a given offer",
        "parameters": [
          {
            "name": "offerId",
            "in": "path",
            "required": true,
            "type": "int"
          },
          {
            "name": "top_k",
            "in": "query",
            "required": false,
            "type": "integer",
            "description": "Number of similar offers to return (max 20)",
            "example": 5
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "offer_id": { "type": "integer", "example": 1 },
                  "title": { "type": "string", "example": "Software Engineer" },
                  "company_id": {
                    "type": "int",
                    "example": 1
                  },
                  "company_name": { "type": "string", "example": "Tech Company" },
                  "location": { "type": "string", "example": "New York, NY" },
                  "job_type": { "type": "string", "example": "CDI" },
                  "work_type": { "type": "string", "example": "On-site" },
                  "about": { "type": "string", "example": "We are looking for a skilled software engineer to join our team." },
                  "salary": { "type": "integer", "example": 120000 },
                  "skills": {
                    "type": "array",
                    "items": { "type": "string" },
                    "example": ["JavaScript", "Node.js", "React"]
                  },
                  "similarity_score": { "type": "number", "example": 0.87 }
                }
              }
            }
          },
          "404": {
            "description": "offer with this id not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/personalized": {
      "post": {
        "tags": ["Recommendations"],
        "description": "Return personalized recommendations based on user view history",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "top_k": {
                  "type": "integer",
                  "example": 5
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "offer_id": { "type": "integer", "example": 1 },
                  "title": { "type": "string", "example": "Software Engineer" },
                  "company_id": { "type": "integer", "example": 1 },
                  "company_name": { "type": "string", "example": "Tech Company" },
                  "location": { "type": "string", "example": "New York, NY" },
                  "job_type": { "type": "string", "example": "CDI" },
                  "work_type": { "type": "string", "example": "On-site" },
                  "about": { "type": "string", "example": "We are looking for a skilled software engineer to join our team." },
                  "salary": { "type": "integer", "example": 120000 },
                  "skills": {
                    "type": "array",
                    "items": { "type": "string" },
                    "example": ["JavaScript", "Node.js", "React"]
                  },
                  "similarity_score": { "type": ["number", "null"], "example": null }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/admin/ingest": {
      "post": {
        "tags": ["Recommendations"],
        "description": "Trigger manual ingestion of WeLoveDevs offers (admin only)",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "description": "Maximum number of offers to ingest (max 500)",
            "example": 100
          }
        ],
        "responses": {
          "202": {
            "description": "Ingestion started"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
