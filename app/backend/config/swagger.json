    "/offersUserLikes": {
      "get": {
        "description": "Get offers that user likes",
        "tags": ["Users"],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
